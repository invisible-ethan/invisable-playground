# AdSense publisher id. Defaults to ca-pub-6470972930893111 (set in vite.config.ts) when blank.
VITE_ADSENSE_CLIENT=

# Ad unit slot ids, from AdSense > Ads > By ad unit. Slots left blank are hidden on the live site.
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_BOTTOM=

# Public URL of the site, e.g. https://example.com. Used for sitemap.xml.
VITE_SITE_URL=

# Email address shown on the contact page.
VITE_CONTACT_EMAIL=

# Where the game is played. Defaults to the game's GitHub repository.
VITE_GAME_URL=
